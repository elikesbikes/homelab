# Ollama — use container name on same Docker network, or remote host for production
OLLAMA_URL=http://ai-ollama-prod-1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava:7b
FIRECRAWL_API_KEY=
SPROUTS_STORE_ID=

# Single external DNS entry — the proxy serves the frontend and forwards PocketBase traffic internally.
# Example: https://groceries.home.elikesbikes.com
VITE_PB_URL=
VITE_PROXY_URL=

PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
